# Copy this file to .env and fill it in.

# ---- Where videos come from ----
# drive  = videos you drop into a Google Drive folder from your phone (recommended)
# tiktok = watch your TikTok profile (TikTok is currently blocking this)
SOURCE=drive
# The ID at the end of the folder's link: drive.google.com/drive/folders/THIS_PART
DRIVE_FOLDER_ID=
TIKTOK_USERNAME=

CHECK_EVERY_MINUTES=15

# ---- Where to post (comma separated: youtube, instagram, facebook, x) ----
# Tip for your first test: POST_TO=youtube and YT_PRIVACY=private
POST_TO=youtube,instagram,facebook

# Caption used when the video still has its camera name (IMG_1234.MOV)
DEFAULT_CAPTION=
# Added to the end of every caption, e.g. "#ugc #ugccreator"
EXTRA_HASHTAGS=
# Used as the YouTube title if the caption is only hashtags
DEFAULT_TITLE=New video
# Delete the downloaded copy once it's posted everywhere
DELETE_AFTER_POST=true

# ---- Google: YouTube + Drive (run: python auth_google.py client_secret.json) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YT_PRIVACY=public
YT_CATEGORY_ID=22

# ---- Instagram Reels (Business/Creator account linked to a Facebook Page) ----
IG_USER_ID=
META_ACCESS_TOKEN=

# ---- Facebook Page Reels ----
FB_PAGE_ID=
FB_PAGE_TOKEN=

META_GRAPH_VERSION=v23.0

# ---- X / Twitter (needs a paid API tier) ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
