# Copy this file to .env and fill it in.

# ---- What to watch ----
TIKTOK_USERNAME=yourtiktokname
CHECK_EVERY_MINUTES=15

# ---- Where to post (comma separated: youtube, instagram, facebook, x) ----
POST_TO=youtube,instagram,facebook

# Added to the end of every caption, e.g. "#ugc #ugccreator"
EXTRA_HASHTAGS=
# Used as the YouTube title if the TikTok caption is only hashtags
DEFAULT_TITLE=New video
# Delete the downloaded mp4 once it's posted everywhere
DELETE_AFTER_POST=true

# ---- YouTube Shorts (run: python auth_youtube.py client_secret.json) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public
YT_CATEGORY_ID=22

# ---- Instagram Reels (Business/Creator account linked to a Facebook Page) ----
IG_USER_ID=
META_ACCESS_TOKEN=

# ---- Facebook Page Reels ----
FB_PAGE_ID=
FB_PAGE_TOKEN=

META_GRAPH_VERSION=v23.0

# ---- X / Twitter (needs a paid API tier) ----
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
